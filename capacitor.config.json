{
  "appId": "app.stafflist",
  "appName": "StaffList",
  "webDir": "dist",
  "server": {
    "url": "https://present-go-five.vercel.app",
    "cleartext": false
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0f0f0f"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 4000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 300,
      "backgroundColor": "#0f0f0f",
      "showSpinner": false
    }
  }
}

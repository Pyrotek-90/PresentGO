{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "PresentGO Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "PresentGO Preview (production build)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "autoPort": false
    }
  ]
}